DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379

PASSWORD_SALT=
PASSWORD_SALT_ROUNDS=12
# Generate secrets with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_HASH_SECRET=

# Links inside emails — the public URLs of the two frontends.
CLIENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Outgoing mail. The dev compose file runs Mailpit (UI on :8025, SMTP on :1025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BeltaCourses <no-reply@beltacourses.com>"
# Where @repo/frontend-emails wrote its output; the default works from apps/api.
# EMAIL_TEMPLATES_DIR=
