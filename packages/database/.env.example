DATABASE_URL=postgresql://<user>:<password>@localhost:<port>/<database>?sslmode=disable

PASSWORD_SALT=
PASSWORD_SALT_ROUNDS=12

# Seeds the first super_admin (packages/database/prisma/seed/super-admin.seed.ts).
# Skipped, without error, when SUPER_ADMIN_EMAIL/SUPER_ADMIN_PASSWORD are unset.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin